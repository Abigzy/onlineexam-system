# ============================================================
#  环境变量模板 —— 复制为 .env 后按需修改（.env 不要提交到 git）
# ============================================================

# ---------------- Django 基础 ----------------
DJANGO_SETTINGS_MODULE=OnlineExam.settings.development
DJANGO_SECRET_KEY=dev-only-change-me-please-0a1b2c3d4e5f60718293a4b5c6d7e8f9
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LANGUAGE_CODE=zh-hans
# 生产环境（production.py）才生效：把 http 强制跳到 https。
# 本机演练 DEBUG=False 又没有 https 时，临时设成 False，否则 curl 会一直吃 301。
SECURE_SSL_REDIRECT=True
# 生产环境用 https 域名时必填，否则后台/表单提交会报 CSRF 校验失败
CSRF_TRUSTED_ORIGINS=https://exam.example.com

# ---------------- 数据库 ----------------
# sqlite = 开箱即用；mysql = 使用你的 MySQL
DB_ENGINE=sqlite
DB_NAME=online_exam
DB_USER=root
DB_PASSWORD=请填写你的MySQL密码
DB_HOST=127.0.0.1
DB_PORT=3306
# MySQL 5.6 专用（用 MySQL 8.0 时两行都可删掉）：
#   DB_SKIP_VERSION_CHECK —— Django 4.2 官方门槛是 8.0.11，5.6 需跳过版本校验
#   DB_CHARSET —— 5.6 的 InnoDB 单列索引上限 767 字节，utf8mb4 建表会失败，必须用 utf8
DB_SKIP_VERSION_CHECK=True
DB_CHARSET=utf8

# ---------------- 跨域（前后端分离时才需要） ----------------
CORS_ALLOW_ALL_ORIGINS=True
# 生产环境 CORS_ALLOW_ALL_ORIGINS=False，改为列白名单（逗号分隔）
CORS_ALLOWED_ORIGINS=

# ---------------- 大模型（第三方 AI 接入） ----------------
# 可选：deepseek / doubao / yuanbao / openai
AI_PROVIDER=deepseek
AI_TIMEOUT=60
AI_MAX_RETRIES=2
# 没配 Key 时是否自动降级为本地模拟回答（课堂演示建议 True，正式环境建议 False）
AI_ALLOW_MOCK=True

# DeepSeek（推荐，https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 豆包 / 火山方舟（https://console.volcengine.com/ark 申请）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k

# 腾讯混元 / 元宝（https://console.cloud.tencent.com/hunyuan 申请）
YUANBAO_API_KEY=
YUANBAO_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
YUANBAO_MODEL=hunyuan-turbos-latest

# 通用 OpenAI 兼容端点（自建网关 / 其他厂商）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------- 生产环境路径（production.py 才生效） ----------------
# 日志目录：不填默认 <项目根>/logs；Linux 建议指向 /var/log/onlineexam（需可写）
DJANGO_LOG_DIR=
# 静态文件收集目录：不填默认 <项目根>/staticfiles；Linux 建议 /var/www/onlineexam/static
DJANGO_STATIC_ROOT=
# 可选：Redis 缓存（不填则用 Django 默认本地内存缓存）
REDIS_URL=
